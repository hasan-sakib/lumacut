  "paths": {
    "/api/assets": {
      "get": {
        "description": "The user's assets, newest first.",
        "operationId": "list_assets_api_assets_get",
        "parameters": [
          {
            "description": "Search in names",
            "in": "query",
            "name": "q",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "maxLength": 200,
                  "type": "string"
                },
                {
                  "type": "null"
                }
